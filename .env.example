# ---------- Base de datos (Supabase / Neon - plan gratuito) ----------
# Usar SIEMPRE el connection string con sslmode=require
DATABASE_URL="postgresql://usuario:password@host:5432/postgres?sslmode=require"

# ---------- Seguridad ----------
# openssl rand -base64 48
JWT_SECRET="cambiar-por-secreto-de-minimo-48-bytes-base64"
# Vida del access token en minutos y del refresh token en dias
ACCESS_TOKEN_TTL_MIN="15"
REFRESH_TOKEN_TTL_DAYS="7"
# Origen publico exacto (obligatorio: valida CSRF por Origin/Referer)
APP_ORIGIN="https://nechimotos.vercel.app"
NODE_ENV="production"

# ---------- Google Sheets (Service Account gratuito) ----------
GOOGLE_SHEETS_SPREADSHEET_ID="1AbCdEf..."
GOOGLE_SHEETS_TAB="REGISTROS"
GOOGLE_SERVICE_ACCOUNT_EMAIL="sync-bot@proyecto.iam.gserviceaccount.com"
# Clave privada con \n escapados
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---------- Cron / sincronizacion ----------
CRON_SECRET="token-largo-para-el-cron-de-vercel"

# ---------- TLS de la base de datos (opcional, recomendado en produccion) ----------
# Verificacion estricta del certificado del servidor. Descargue el .crt en
# Supabase -> Settings -> Database -> SSL Configuration, o en el panel de Neon,
# y ponga aqui la ruta del archivo (o el PEM completo con \n escapados).
# Sin esta variable y con sslmode=require, el trafico va cifrado pero no se
# verifica el emisor del certificado.
DATABASE_CA_CERT=""
